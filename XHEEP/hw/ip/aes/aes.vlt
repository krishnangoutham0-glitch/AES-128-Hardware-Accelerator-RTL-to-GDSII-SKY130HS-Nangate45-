`verilator_config

// Generated by regtool: module/file naming does not follow Verilator's
// DECLFILENAME convention.
lint_off -rule DECLFILENAME -file "*/aes/rtl/aes_reg_top.sv"

// AES peripheral register structure contains fields that are not used
// by the current AES implementation.
lint_off -rule UNUSEDSIGNAL -file "*/aes/rtl/aes.sv"

// Some intermediate signals in the AES core are currently unused.
lint_off -rule UNUSEDSIGNAL -file "*/aes/rtl/aes_core.sv"
